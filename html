<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proyecto Gallinero - Simulación & Genética</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js para el gráfico del mercado -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts: VT323 & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #121826;
            color: #f3f4f6;
            user-select: none;
        }
        .font-pixel {
            font-family: 'VT323', monospace;
        }
        /* Animación suave para las gallinas en el corral */
        @keyframes bob {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-6px) rotate(2deg); }
        }
        @keyframes peck {
            0%, 100% { transform: rotate(0deg); }
            30% { transform: rotate(15deg) translateY(4px); }
        }
        .animate-chicken {
            animation: bob 3s ease-in-out infinite;
        }
        .animate-peck {
            animation: peck 1.5s ease-in-out infinite;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1f2937;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden bg-slate-950 text-slate-100">

    <!-- TOP BAR / HUD -->
    <header class="bg-slate-900 border-b border-slate-800 px-4 py-3 flex flex-wrap items-center justify-between shadow-lg z-10">
        <div class="flex items-center space-x-3">
            <div class="bg-amber-500/20 p-2 rounded-lg border border-amber-500/40 text-amber-400">
                <i class="fa-solid font-pixel text-2xl fa-egg"></i>
            </div>
            <div>
                <h1 class="font-pixel text-2xl tracking-wider text-amber-400 leading-none">PROYECTO GALLINERO</h1>
                <p class="text-xs text-slate-400">Simulador de Cría & Genética v1.0</p>
            </div>
        </div>

        <!-- Recursos del Jugador -->
        <div class="flex items-center space-x-6 text-sm">
            <!-- Dinero -->
            <div class="bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 flex items-center space-x-2">
                <i class="fa-solid fa-coins text-yellow-400 text-lg"></i>
                <div>
                    <div class="text-xs text-slate-400">Dinero</div>
                    <div id="hud-money" class="font-bold text-yellow-400">$150.00</div>
                </div>
            </div>

            <!-- Nivel / Reputación -->
            <div class="bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 flex items-center space-x-2">
                <i class="fa-solid fa-star text-amber-400 text-lg"></i>
                <div>
                    <div class="text-xs text-slate-400">Nivel Granja</div>
                    <div id="hud-level" class="font-bold text-amber-300">Niv. 1 (Corral Rústico)</div>
                </div>
            </div>

            <!-- Alimento en Stock -->
            <div class="bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 flex items-center space-x-2">
                <i class="fa-solid fa-wheat-awn text-amber-500 text-lg"></i>
                <div>
                    <div class="text-xs text-slate-400">Comida (Kg)</div>
                    <div id="hud-food" class="font-bold text-slate-200">20 / 50 kg</div>
                </div>
            </div>

            <!-- Huevos en Almacén -->
            <div class="bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 flex items-center space-x-2">
                <i class="fa-solid fa-basket-shopping text-emerald-400 text-lg"></i>
                <div>
                    <div class="text-xs text-slate-400">Huevos en Cesta</div>
                    <div id="hud-eggs" class="font-bold text-emerald-400">0</div>
                </div>
            </div>

            <!-- Clima / Tiempo -->
            <div class="bg-slate-800/80 px-3 py-1.5 rounded-lg border border-slate-700 flex items-center space-x-2">
                <i id="hud-weather-icon" class="fa-solid fa-sun text-amber-400 text-lg"></i>
                <div>
                    <div id="hud-season" class="text-xs text-slate-400">Primavera</div>
                    <div id="hud-temp" class="font-bold text-slate-200">22°C</div>
                </div>
            </div>
        </div>
    </header>

    <!-- CONTAINER PRINCIPAL (NAVIGATION & VIEWS) -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- SIDEBAR DE NAVEGACIÓN -->
        <nav class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between p-3">
            <div class="space-y-1">
                <button onclick="switchTab('coop')" id="nav-coop" class="tab-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-left transition bg-amber-500/10 text-amber-400 border border-amber-500/30">
                    <i class="fa-solid fa-warehouse text-lg"></i>
                    <span>El Gallinero</span>
                </button>
                <button onclick="switchTab('genetics')" id="nav-genetics" class="tab-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-left transition text-slate-400 hover:bg-slate-800 hover:text-slate-200">
                    <i class="fa-solid fa-dna text-lg"></i>
                    <span>Criadero & Genética</span>
                </button>
                <button onclick="switchTab('market')" id="nav-market" class="tab-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-left transition text-slate-400 hover:bg-slate-800 hover:text-slate-200">
                    <i class="fa-solid fa-store text-lg"></i>
                    <span>Mercado Agrícola</span>
                </button>
                <button onclick="switchTab('upgrades')" id="nav-upgrades" class="tab-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-left transition text-slate-400 hover:bg-slate-800 hover:text-slate-200">
                    <i class="fa-solid fa-hammer text-lg"></i>
                    <span>Mejoras & Obras</span>
                </button>
            </div>

            <!-- Mini Panel de Estadísticas del Gallinero -->
            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs space-y-2">
                <div class="flex justify-between text-slate-400">
                    <span>Población Total:</span>
                    <span id="stat-count" class="font-bold text-slate-200">0 / 5</span>
                </div>
                <div class="flex justify-between text-slate-400">
                    <span>Higiene del Corral:</span>
                    <span id="stat-cleanliness" class="font-bold text-emerald-400">100%</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                    <div id="bar-cleanliness" class="bg-emerald-500 h-full w-full transition-all duration-300"></div>
                </div>
            </div>
        </nav>

        <!-- VISTAS / CONTENIDO -->
        <main class="flex-1 bg-slate-950 p-6 overflow-y-auto relative">

            <!-- TAB 1: EL GALLINERO -->
            <section id="tab-coop" class="space-y-6">
                <!-- Barra de Acciones Rápidas -->
                <div class="bg-slate-900 p-4 rounded-2xl border border-slate-800 flex flex-wrap gap-3 items-center justify-between">
                    <div class="flex gap-3">
                        <button onclick="feedBirds()" class="bg-amber-600 hover:bg-amber-500 text-white px-4 py-2.5 rounded-xl font-medium shadow-lg transition flex items-center space-x-2">
                            <i class="fa-solid fa-wheat-awn"></i>
                            <span>Alimentar Aves</span>
                        </button>
                        <button onclick="cleanCoop()" class="bg-teal-600 hover:bg-teal-500 text-white px-4 py-2.5 rounded-xl font-medium shadow-lg transition flex items-center space-x-2">
                            <i class="fa-solid fa-broom"></i>
                            <span>Limpiar Gallinero</span>
                        </button>
                        <button onclick="collectEggs()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2.5 rounded-xl font-medium shadow-lg transition flex items-center space-x-2">
                            <i class="fa-solid fa-egg"></i>
                            <span>Recolectar Huevos</span>
                        </button>
                    </div>

                    <div class="text-xs text-slate-400 flex items-center space-x-4">
                        <span class="flex items-center"><i class="fa-solid fa-circle text-emerald-500 text-[8px] mr-1.5"></i> Óptimo</span>
                        <span class="flex items-center"><i class="fa-solid fa-circle text-amber-500 text-[8px] mr-1.5"></i> Hambriento</span>
                        <span class="flex items-center"><i class="fa-solid fa-circle text-rose-500 text-[8px] mr-1.5"></i> Enfermo</span>
                    </div>
                </div>

                <!-- Corral Visual (Gráfico 2D Interactivo) -->
                <div class="relative bg-gradient-to-b from-amber-950/20 via-emerald-950/20 to-slate-900 border-2 border-dashed border-slate-800 rounded-2xl min-h-[280px] p-6 flex flex-wrap gap-6 items-end justify-start overflow-hidden">
                    <div class="absolute top-3 left-4 text-xs font-pixel text-slate-500 tracking-wider">CORRAL AL AIRE LIBRE - VISTA EN VIVO</div>
                    
                    <!-- Nidos Visuales en la esquina -->
                    <div class="absolute top-4 right-4 flex space-x-3 bg-slate-900/80 p-2.5 rounded-xl border border-slate-800">
                        <div class="text-center">
                            <div class="text-xs text-slate-400 mb-1">Nidos</div>
                            <div class="flex space-x-2" id="nests-container">
                                <!-- Generado por JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Gallinas rendered aquí -->
                    <div id="coop-chickens-container" class="w-full flex flex-wrap gap-6 items-center z-10 min-h-[160px]">
                        <!-- Rendered by JavaScript -->
                    </div>
                </div>

                <!-- Lista Detallada de Aves -->
                <div>
                    <h3 class="text-lg font-semibold text-slate-200 mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-list-check text-amber-400"></i>
                        Inventario de Aves en el Corral
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="birds-cards-container">
                        <!-- Cards dinámicas por JS -->
                    </div>
                </div>
            </section>

            <!-- TAB 2: CRIADERO & GENÉTICA -->
            <section id="tab-genetics" class="space-y-6 hidden">
                <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800">
                    <h2 class="text-xl font-bold text-amber-400 mb-2 flex items-center gap-2">
                        <i class="fa-solid fa-dna"></i> Centro de Cruza y Genética
                    </h2>
                    <p class="text-sm text-slate-400 mb-6">Selecciona un Gallo reproductor y una Gallina fértil para combinar su ADN. Las crías heredarán estadísticas con posibilidad de mutación genéticas y nuevas razas.</p>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Seleccionar Padre (Gallo) -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                            <label class="block text-sm font-semibold text-slate-300 mb-2">Padre (Gallo ♂)</label>
                            <select id="select-rooster" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm text-slate-200 focus:outline-none focus:border-amber-500">
                                <option value="">-- Seleccionar Gallo --</option>
                            </select>
                            <div id="rooster-preview" class="mt-4 p-3 bg-slate-900/50 rounded-lg border border-slate-800 hidden text-xs space-y-1">
                                <!-- Preview stats -->
                            </div>
                        </div>

                        <!-- Seleccionar Madre (Gallina) -->
                        <div class="bg-slate-950 p-4 rounded-xl border border-slate-800">
                            <label class="block text-sm font-semibold text-slate-300 mb-2">Madre (Gallina ♀)</label>
                            <select id="select-hen" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-sm text-slate-200 focus:outline-none focus:border-amber-500">
                                <option value="">-- Seleccionar Gallina --</option>
                            </select>
                            <div id="hen-preview" class="mt-4 p-3 bg-slate-900/50 rounded-lg border border-slate-800 hidden text-xs space-y-1">
                                <!-- Preview stats -->
                            </div>
                        </div>
                    </div>

                    <!-- Botón de Acción -->
                    <div class="mt-6 flex justify-center">
                        <button onclick="breedBirds()" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold px-8 py-3.5 rounded-xl shadow-lg transition transform active:scale-95 flex items-center space-x-2">
                            <i class="fa-solid fa-heart text-rose-600"></i>
                            <span>Cruzar Aves Seleccionadas</span>
                        </button>
                    </div>
                </div>

                <!-- Enciclopedia de Razas Descubiertas -->
                <div class="bg-slate-900 p-6 rounded-2xl border border-slate-800">
                    <h3 class="text-lg font-semibold text-slate-200 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-book-bookmark text-amber-400"></i>
                        Registro de Razas & Mutaciones
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="breed-encyclopedia">
                        <!-- Cards de razas -->
                    </div>
                </div>
            </section>

            <!-- TAB 3: MERCADO AGRÍCOLA -->
            <section id="tab-market" class="space-y-6 hidden">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Gráfico de Precios -->
                    <div class="lg:col-span-2 bg-slate-900 p-6 rounded-2xl border border-slate-800">
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                <h3 class="text-lg font-bold text-slate-200">Bolsa Agrícola de Huevos</h3>
                                <p class="text-xs text-slate-400">Fluctuación de valor en tiempo real según la demanda</p>
                            </div>
                            <div class="text-right">
                                <span class="text-xs text-slate-400">Precio Actual / Huevo:</span>
                                <div id="current-egg-price" class="text-xl font-bold text-emerald-400">$2.50</div>
                            </div>
                        </div>
                        <div class="h-64">
                            <canvas id="marketChart"></canvas>
                        </div>
                    </div>

                    <!-- Venta y Suministros -->
                    <div class="space-y-4">
                        <!-- Vender Huevos -->
                        <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800">
                            <h4 class="font-semibold text-slate-200 mb-3 flex items-center gap-2">
                                <i class="fa-solid fa-basket-shopping text-emerald-400"></i> Vender Producción
                            </h4>
                            <p class="text-xs text-slate-400 mb-4">Vende tus huevos acumulados al precio de mercado actual.</p>
                            <button onclick="sellEggs()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-3 rounded-xl transition shadow-lg flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-hand-holding-dollar"></i>
                                <span>Vender Todos los Huevos</span>
                            </button>
                        </div>

                        <!-- Comprar Insumos -->
                        <div class="bg-slate-900 p-5 rounded-2xl border border-slate-800 space-y-3">
                            <h4 class="font-semibold text-slate-200 mb-2 flex items-center gap-2">
                                <i class="fa-solid fa-cart-shopping text-amber-400"></i> Comprar Insumos
                            </h4>

                            <div class="flex justify-between items-center p-3 bg-slate-950 rounded-xl border border-slate-800">
                                <div>
                                    <div class="text-sm font-medium text-slate-200">Saco de Maíz (10kg)</div>
                                    <div class="text-xs text-slate-400">Alimento básico</div>
                                </div>
                                <button onclick="buySupplies('food', 15, 10)" class="bg-slate-800 hover:bg-slate-700 text-amber-400 font-bold px-3 py-1.5 rounded-lg text-xs border border-slate-700">
                                    $15.00
                                </button>
                            </div>

                            <div class="flex justify-between items-center p-3 bg-slate-950 rounded-xl border border-slate-800">
                                <div>
                                    <div class="text-sm font-medium text-slate-200">Vacuna Aviar</div>
                                    <div class="text-xs text-slate-400">Cura aves enfermas</div>
                                </div>
                                <button onclick="buySupplies('medicine', 25, 1)" class="bg-slate-800 hover:bg-slate-700 text-rose-400 font-bold px-3 py-1.5 rounded-lg text-xs border border-slate-700">
                                    $25.00
                                </button>
                            </div>

                            <div class="flex justify-between items-center p-3 bg-slate-950 rounded-xl border border-slate-800">
                                <div>
                                    <div class="text-sm font-medium text-slate-200">Comprar Gallina Leghorn</div>
                                    <div class="text-xs text-slate-400">Raza común productora</div>
                                </div>
                                <button on